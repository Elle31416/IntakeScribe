services:
  - type: web
    name: ai-voice-intake-scribe
    runtime: node
    plan: free
    buildCommand: npm install
    startCommand: npm start
    healthCheckPath: /
    envVars:
      # sync: false makes Render prompt for a value during Blueprint creation
      - key: ASSEMBLYAI_API_KEY
        sync: false
      # Which agents/<name>.jsonc the service publishes on boot.
      - key: AGENT
        value: riverbend-agent
      # Serve this exact stored agent (Riverbend pre-visit intake).
      # Replace with the AGENT_ID printed by `npm run publish`, or omit this
      # var entirely to let the service publish agents/<AGENT>.jsonc on boot.
      - key: AGENT_ID
        sync: false
      # Optional: pin API base if your account is regional
      # - key: AGENTS_API_BASE
      #   value: https://agents.assemblyai.com/v1
